{
  "name": "gokan-srs-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.2.18",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=@gokan-srs/web",
    "build": "turbo build",
    "test": "bun test",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "build:data": "bun run build:kanji && bun scripts/build-data.ts",
    "build:kanji": "bun scripts/build-kanji.ts",
    "build:jpdb": "node scripts/jpdb-v2.2-tsv-to-json.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/react-native-web": "^0.19.2",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "kuromoji": "^0.1.2",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "turbo": "^2.9.14",
    "typescript": "~5.9.3",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "react-native": "0.85.3",
    "react-native-reanimated": "^4.2.2",
    "react-native-svg": "^15.15.3"
  }
}
