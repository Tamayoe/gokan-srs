{
    "compilerOptions": {
        "baseUrl": ".",
        "jsx": "react-jsx",
        "moduleResolution": "bundler",
        "module": "ESNext",
        "target": "ES2022",
        "strict": true,
        "skipLibCheck": true,
        "paths": {
            "@gokan-srs/core": [
                "../core/src/index.ts"
            ],
            "@gokan-srs/core/*": [
                "../core/src/*"
            ],
            "@gokan-srs/ui": [
                "../ui/src/index.ts"
            ],
            "@gokan-srs/app/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "src/**/*"
    ]
}