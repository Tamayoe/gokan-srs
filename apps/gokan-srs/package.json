    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "react-virtuoso": "^4.18.1",
    "rimraf": "^6.1.2",
    "terser": "^5.44.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
